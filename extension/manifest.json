{
  "manifest_version": 3,
  "name": "ChudPresence Chromium Activity Lab",
  "version": "1.9.0",
  "description": "Local Chromium MV3 lab for developing playback Activities.",
  "minimum_chrome_version": "135",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ChudPresence Chromium Activity Lab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://67movies.st/*", "https://www.67movies.st/*"],
      "js": ["movies67.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"],
      "js": ["twitch.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://kick.com/*", "https://www.kick.com/*"],
      "js": ["kick.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["alarms", "identity", "offscreen", "storage", "userScripts"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": [
    "https://discord.com/api/*",
    "https://discord.com/oauth2/*"
  ]
}
